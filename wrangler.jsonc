{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kalki-alpaca-autotrader",
  "main": "src/index.js",
  "compatibility_date": "2026-05-06",
  "vars": {
    "ALPACA_BASE_URL": "https://paper-api.alpaca.markets",
    "SECRET_PATH": "kalki2026",
    "POSITION_SIZE": "1000",
    "MIN_GRADE": "B",
    "SOURCE_CHAT_ID": ""
  },
  // Optional: bind a KV namespace as AUTOTRADER_STATE for durable pause/resume.
  // "kv_namespaces": [
  //   {
  //     "binding": "AUTOTRADER_STATE",
  //     "id": "your-kv-namespace-id"
  //   }
  // ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
